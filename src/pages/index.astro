---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout>
  <section class="hero container">
    <div>
      <p class="eyebrow">Physique · Comprendre · Expérimenter</p>
      <h1>La science se construit en la mettant à l’épreuve.</h1>
      <p class="hero-copy">Le futur point d’entrée vers des ressources, des jeux et des expériences interactives.</p>
      <div class="hero-actions">
        <a class="primary-action" href={`${base}/simulations/`}>Explorer la structure</a>
        <a class="secondary-action" href={`${base}/projets/`}>Voir les projets</a>
      </div>
    </div>
    <div class="orbit" aria-hidden="true">
      <span class="orbit-ring ring-one"></span><span class="orbit-ring ring-two"></span>
      <span class="orbit-core"></span><span class="orbit-particle particle-one"></span><span class="orbit-particle particle-two"></span>
    </div>
  </section>

  <section class="container direction" aria-labelledby="direction-title">
    <p class="eyebrow">Socle V0</p>
    <h2 id="direction-title">Un contenant prêt pour les prochains contenus.</h2>
    <div class="direction-grid">
      <article><span>01</span><h3>Lire</h3><p>Des pages claires pour les cours, dossiers et explications.</p></article>
      <article><span>02</span><h3>Observer</h3><p>Des cadres cohérents pour images, vidéos et animations.</p></article>
      <article><span>03</span><h3>Expérimenter</h3><p>Des jeux et simulations autonomes, intégrables sans les réécrire.</p></article>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { display: grid; min-height: calc(100vh - 4.8rem); grid-template-columns: minmax(0, 1.3fr) minmax(18rem, 0.7fr); align-items: center; gap: var(--space-6); padding-block: var(--space-7); }
  h1 { max-width: 12ch; margin: 0; font-family: var(--font-display); font-size: clamp(3.1rem, 7.5vw, 7rem); font-weight: 760; letter-spacing: -0.065em; line-height: 0.92; }
  .hero-copy { max-width: 40rem; margin: var(--space-5) 0 0; color: var(--color-muted); font-size: clamp(1.05rem, 2vw, 1.28rem); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }
  .hero-actions a { padding: 0.8rem 1.15rem; border-radius: var(--radius-sm); font-weight: 750; text-decoration: none; }
  .primary-action { background: var(--color-primary); color: white; }
  .primary-action:hover { background: var(--color-primary-dark); }
  .secondary-action { border: 1px solid var(--color-line); background: var(--color-surface); }
  .orbit { position: relative; width: min(100%, 28rem); aspect-ratio: 1; margin-inline: auto; }
  .orbit-ring, .orbit-core, .orbit-particle { position: absolute; border-radius: 50%; }
  .orbit-ring { inset: 10%; border: 1px solid rgba(13, 107, 87, 0.35); }
  .ring-two { inset: 24%; border-color: rgba(237, 139, 66, 0.55); }
  .orbit-core { inset: 39%; background: var(--color-primary); box-shadow: 0 0 0 1.2rem rgba(13, 107, 87, 0.08); }
  .orbit-particle { width: 1.25rem; aspect-ratio: 1; background: var(--color-accent); box-shadow: 0 0 0 0.45rem rgba(237, 139, 66, 0.13); }
  .particle-one { top: 8%; left: 46%; }
  .particle-two { right: 18%; bottom: 20%; width: 0.8rem; }
  .direction { padding-block: var(--space-7); border-top: 1px solid var(--color-line); }
  .direction > h2 { max-width: 17ch; margin: 0; font-family: var(--font-display); font-size: clamp(2.25rem, 5vw, 4.5rem); letter-spacing: -0.055em; line-height: 1; }
  .direction-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin-top: var(--space-6); background: var(--color-line); border: 1px solid var(--color-line); border-radius: var(--radius-lg); overflow: hidden; }
  .direction-grid article { min-height: 18rem; padding: var(--space-5); background: var(--color-surface); }
  .direction-grid span { color: var(--color-primary); font-size: 0.78rem; font-weight: 800; letter-spacing: 0.12em; }
  .direction-grid h3 { margin: 5rem 0 var(--space-2); font-family: var(--font-display); font-size: 1.65rem; letter-spacing: -0.035em; }
  .direction-grid p { margin: 0; color: var(--color-muted); }
  @media (max-width: 52rem) {
    .hero { min-height: auto; grid-template-columns: 1fr; }
    .orbit { width: min(70vw, 22rem); }
    .direction-grid { grid-template-columns: 1fr; }
    .direction-grid article { min-height: 13rem; }
    .direction-grid h3 { margin-top: var(--space-5); }
  }
</style>
