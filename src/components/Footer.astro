---
import { site } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p><strong>{site.name}</strong><br />Physicist, teacher and hands-on science designer.</p>
    <p>© {year} {site.author}</p>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--color-line); }
  .footer-inner { display: flex; align-items: end; justify-content: space-between; gap: var(--space-4); padding-block: var(--space-5); color: var(--color-muted); font-size: 0.9rem; }
  .footer-inner p { margin: 0; }
  .footer-inner strong { color: var(--color-ink); }
  @media (max-width: 38rem) { .footer-inner { display: grid; align-items: start; } }
</style>
