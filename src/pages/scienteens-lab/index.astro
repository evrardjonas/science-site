---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkshopMedia from '../../components/WorkshopMedia.astro';
import content from '../../content/scienteens.json';

const { meta, hero, interview, game, other } = content;
const assetUrl = (path: string) => `${import.meta.env.BASE_URL}${path}`;
---

<BaseLayout title={meta.title} description={meta.description} lang="en">
  <section class="portfolio-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1>{hero.title}</h1>
        <p class="lead">{hero.introduction}</p>
        <nav class="section-tabs" aria-label="Scienteens Lab sections">
          <a class="primary-tab" href={'#' + interview.id}>{interview.tab}</a>
          <a href={'#' + game.id}>Game</a>
          <a href={'#' + other.id}>{other.tab}</a>
        </nav>
      </div>

      <aside class="brief" aria-label="Interview workshop summary">
        <span class="brief-number">Interview workshop</span>
        {interview.facts.map((fact) => (
          <div>
            <span>{fact.label}</span>
            <strong>{fact.value}</strong>
          </div>
        ))}
      </aside>
    </div>
  </section>

  <section id={interview.id} class="section container">
    <header class="section-heading">
      <div>
        <p class="eyebrow">{interview.eyebrow}</p>
        <h2>{interview.title}</h2>
      </div>
      <p>{interview.summary}</p>
    </header>

    <nav aria-label="Workshop sequence">
      <ol class="story-index">
        {interview.steps.map((step) => (
          <li>
            <a href={'#' + step.id}>
              <span>{step.number}</span>
              <strong>{step.title}</strong>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="story">
      {interview.steps.map((step) => (
        <article id={step.id} class:list={['story-step', { 'kundt-step': step.id === 'kundt' }]}>
          <header class="step-heading">
            <span class="step-number" aria-hidden="true">{step.number}</span>
            <div>
              <p class="eyebrow">{step.eyebrow}</p>
              <h3>{step.title}</h3>
            </div>
          </header>

          <div class:list={['step-layout', { 'with-visual': step.id === 'closed-tube' || Boolean(step.media && step.media.type !== 'placeholder') }]}>
            <div class="step-copy">
              {step.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

              {step.formulas.length > 0 && (
                <div class="formula-row" aria-label="Equations used in this part">
                  {step.formulas.map((formula) => <code>{formula}</code>)}
                </div>
              )}

              {step.source && (
                <a class="source-link" href={step.source.url} target="_blank" rel="noreferrer">
                  <span>Primary source</span>
                  {step.source.label}
                  <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>

            {step.id === 'closed-tube' && (
              <div class="visual-stack">
                {step.media && step.media.type !== 'placeholder' && (
                  <WorkshopMedia item={step.media} />
                )}
                <div class="wave-lab">
                  <div class="wave-label"><span>closed end</span><span>air displacement</span><span>closed end</span></div>
                  <svg viewBox="0 0 720 300" role="img" aria-label="Schematic of a standing displacement wave in a tube closed at both ends">
                    <rect x="32" y="48" width="656" height="204" rx="18"></rect>
                    <line x1="32" y1="150" x2="688" y2="150"></line>
                    <path class="wave wave-one" d="M32 150 C87 58 142 58 197 150 S307 242 362 150 S472 58 527 150 S637 242 688 150"></path>
                    <path class="wave wave-two" d="M32 150 C87 242 142 242 197 150 S307 58 362 150 S472 242 527 150 S637 58 688 150"></path>
                    <g class="nodes">
                      <circle cx="32" cy="150" r="8"></circle><circle cx="197" cy="150" r="8"></circle>
                      <circle cx="362" cy="150" r="8"></circle><circle cx="527" cy="150" r="8"></circle><circle cx="688" cy="150" r="8"></circle>
                    </g>
                  </svg>
                  <div class="wave-label"><span>node</span><span class="wave-equation">L = nλ / 2</span><span>node</span></div>
                </div>
              </div>
            )}

            {step.id !== 'closed-tube' && step.media && step.media.type !== 'placeholder' && (
              <WorkshopMedia item={step.media} />
            )}
          </div>

          {step.substeps.length > 0 && (
            <ol class="substeps">
              {step.substeps.map((substep) => (
                <li>
                  <div class="substep-copy">
                    <span>{substep.number}</span>
                    <h4>{substep.title}</h4>
                    <p>{substep.text}</p>
                    {substep.formula && <code>{substep.formula}</code>}
                  </div>
                  {substep.media.length > 0 && (
                    <div class="substep-media">
                      {substep.media.map((item) => <WorkshopMedia item={item} />)}
                    </div>
                  )}
                </li>
              ))}
            </ol>
          )}

          {step.media?.type === 'placeholder' && (
            <WorkshopMedia item={step.media} wide={true} />
          )}
        </article>
      ))}
    </div>
  </section>

  <section id={game.id} class="section container game-section" aria-labelledby="game-title">
    <header class="section-heading compact-heading">
      <div>
        <p class="eyebrow">{game.eyebrow}</p>
        <h2 id="game-title">{game.title}</h2>
      </div>
      <p>{game.description}</p>
    </header>

    <div class="game-shell">
      <div class="game-toolbar">
        <span>Interactive HTML activity</span>
        <a href={assetUrl(game.src)} target="_blank" rel="noreferrer">Open full screen <span aria-hidden="true">↗</span></a>
      </div>
      <iframe
        src={assetUrl(game.src)}
        title="The Resonance Lab interactive game"
        loading="lazy"
        allow="autoplay"
        allowfullscreen
      ></iframe>
    </div>
  </section>

  <section id={other.id} class="section container other-section" aria-labelledby="other-title">
    <header class="section-heading compact-heading">
      <div>
        <p class="eyebrow">{other.eyebrow}</p>
        <h2 id="other-title">{other.title}</h2>
      </div>
      <p>{other.description}</p>
    </header>

    <div class="resource-list">
      {other.resources.map((resource) => (
        <a class="resource-card" href={assetUrl(resource.href)} target="_blank" rel="noreferrer">
          <span>{resource.label}</span>
          <h3>{resource.title}</h3>
          <p>{resource.description}</p>
          <strong>{resource.meta}<span aria-hidden="true"> ↗</span></strong>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .portfolio-hero { padding-block: clamp(4.5rem, 10vw, 9rem); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 0.55fr); gap: clamp(3rem, 8vw, 8rem); align-items: end; }
  h1 { max-width: 11ch; margin: 0; font-family: var(--font-display); font-size: clamp(3.7rem, 8vw, 7.6rem); font-weight: 760; letter-spacing: -0.07em; line-height: 0.9; }
  .lead { max-width: var(--text-width); margin: var(--space-5) 0 0; color: var(--color-muted); font-size: clamp(1.12rem, 2.2vw, 1.45rem); }
  .section-tabs { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-5); }
  .section-tabs a { padding: 0.62rem 0.85rem; border: 1px solid var(--color-line); border-radius: var(--radius-sm); background: var(--color-surface); color: var(--color-primary-dark); font-size: 0.9rem; font-weight: 750; text-decoration: none; }
  .section-tabs a:hover { border-color: var(--color-primary); }
  .section-tabs .primary-tab { border-color: var(--color-ink); background: var(--color-ink); color: var(--color-surface); }
  .brief { display: grid; gap: var(--space-4); padding: var(--space-5); border-radius: var(--radius-lg); background: var(--color-ink); color: var(--color-surface); }
  .brief-number { color: var(--color-accent); font-size: 0.78rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }
  .brief div { display: grid; gap: var(--space-1); padding-top: var(--space-3); border-top: 1px solid var(--color-muted); }
  .brief div span { color: var(--color-line); font-size: 0.75rem; font-weight: 750; letter-spacing: 0.1em; text-transform: uppercase; }
  .brief strong { font-family: var(--font-display); font-size: 1.25rem; line-height: 1.25; }
  .section { padding-block: var(--space-7); scroll-margin-top: var(--space-7); }
  .section-heading { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(17rem, 0.55fr); column-gap: clamp(2rem, 7vw, 7rem); align-items: end; margin-bottom: var(--space-6); }
  .section-heading h2 { max-width: 16ch; margin: 0; font-family: var(--font-display); font-size: clamp(2.5rem, 5vw, 4.7rem); letter-spacing: -0.06em; line-height: 0.98; }
  .section-heading > p { margin: 0; color: var(--color-muted); }
  .story-index { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); padding: 0; margin: 0 0 var(--space-7); list-style: none; border-block: 1px solid var(--color-line); }
  .story-index li { border-right: 1px solid var(--color-line); }
  .story-index li:last-child { border-right: 0; }
  .story-index a { display: grid; align-content: space-between; min-height: 9.5rem; padding: var(--space-3); color: var(--color-ink); text-decoration: none; }
  .story-index a:hover { background: var(--color-surface-strong); }
  .story-index span { color: var(--color-primary); font-size: 0.72rem; font-weight: 850; letter-spacing: 0.1em; }
  .story-index strong { max-width: 15ch; font-family: var(--font-display); font-size: 1rem; line-height: 1.12; }
  .story { display: grid; gap: var(--space-6); }
  .story-step { padding: clamp(1.5rem, 4vw, 3.5rem); scroll-margin-top: var(--space-5); border: 1px solid var(--color-line); border-radius: var(--radius-lg); background: var(--color-surface); box-shadow: var(--shadow-soft); }
  .step-heading { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-4); align-items: start; }
  .step-number { display: grid; place-items: center; width: 3rem; aspect-ratio: 1; border-radius: var(--radius-sm); background: var(--color-ink); color: var(--color-accent); font-size: 0.75rem; font-weight: 850; letter-spacing: 0.08em; }
  .step-heading h3 { max-width: 18ch; margin: 0; font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3.6rem); letter-spacing: -0.055em; line-height: 1; }
  .step-layout { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(22rem, 1.2fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; margin-top: var(--space-5); }
  .step-copy { grid-column: 1 / -1; max-width: var(--text-width); margin-left: calc(3rem + var(--space-4)); }
  .step-layout.with-visual .step-copy { grid-column: auto; margin-left: calc(3rem + var(--space-4)); }
  .step-copy > p { color: var(--color-muted); font-size: 1.05rem; }
  .step-copy > p:first-child { margin-top: 0; }
  .formula-row { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }
  code { display: inline-block; padding: 0.55rem 0.75rem; border-radius: var(--radius-sm); background: var(--color-surface-strong); color: var(--color-primary-dark); font-family: var(--font-display); font-size: 1.05rem; font-weight: 750; }
  .source-link { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: baseline; width: fit-content; margin-top: var(--space-5); color: var(--color-primary-dark); font-size: 0.82rem; font-weight: 700; text-underline-offset: 0.2em; }
  .source-link > span:first-child { color: var(--color-muted); font-size: 0.68rem; font-weight: 800; letter-spacing: 0.11em; text-transform: uppercase; }
  .wave-lab { display: grid; align-content: space-between; min-height: 22rem; padding: var(--space-4); border-radius: var(--radius-md); background: var(--color-ink); color: var(--color-surface); }
  .wave-label { display: flex; justify-content: space-between; gap: var(--space-3); color: var(--color-line); font-size: 0.67rem; font-weight: 750; letter-spacing: 0.09em; text-transform: uppercase; }
  .visual-stack { display: grid; gap: var(--space-4); min-width: 0; }
  .visual-stack > :global(.workshop-media) { width: min(100%, 18rem); justify-self: center; }
  .wave-equation { letter-spacing: 0; text-transform: none; }
  .wave-lab svg { width: 100%; }
  .wave-lab rect { fill: none; stroke: var(--color-muted); stroke-width: 2; }
  .wave-lab line { stroke: var(--color-muted); stroke-dasharray: 5 7; }
  .wave { fill: none; stroke-width: 4; }
  .wave-one { stroke: var(--color-accent); }
  .wave-two { stroke: var(--color-surface-strong); }
  .nodes circle { fill: var(--color-surface); }
  .substeps { display: grid; gap: var(--space-3); padding: 0; margin: var(--space-6) 0 0 calc(3rem + var(--space-4)); list-style: none; }
  .substeps li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.58fr); gap: var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--color-line); }
  .substep-media { display: grid; gap: var(--space-4); min-width: 0; }
  .substep-copy > span { color: var(--color-primary); font-size: 0.73rem; font-weight: 850; letter-spacing: 0.1em; }
  .substep-copy h4 { margin: var(--space-2) 0; font-family: var(--font-display); font-size: 1.55rem; letter-spacing: -0.035em; line-height: 1.08; }
  .substep-copy p { max-width: var(--text-width); margin-bottom: 0; color: var(--color-muted); }
  .substep-copy code { margin-top: var(--space-3); }
  .other-section, .game-section { border-top: 1px solid var(--color-line); }
  .compact-heading { margin-bottom: 0; }
  .game-shell { overflow: hidden; margin-top: var(--space-6); border: 1px solid var(--color-line); border-radius: var(--radius-lg); background: var(--color-ink); box-shadow: var(--shadow-soft); }
  .game-toolbar { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3); align-items: center; padding: var(--space-3) var(--space-4); color: var(--color-surface); }
  .game-toolbar > span { color: var(--color-line); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .game-toolbar a { color: var(--color-accent); font-size: 0.82rem; font-weight: 800; text-underline-offset: 0.2em; }
  .game-shell iframe { display: block; width: 100%; height: min(78vh, 58rem); min-height: 42rem; border: 0; background: #0d1720; }
  .resource-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); margin-top: var(--space-6); }
  .resource-card { display: grid; gap: var(--space-2); min-height: 15rem; padding: var(--space-5); border: 1px solid var(--color-line); border-radius: var(--radius-lg); background: var(--color-surface); color: var(--color-ink); text-decoration: none; box-shadow: var(--shadow-soft); }
  .resource-card:hover { border-color: var(--color-primary); }
  .resource-card > span { color: var(--color-primary); font-size: 0.72rem; font-weight: 850; letter-spacing: 0.11em; text-transform: uppercase; }
  .resource-card h3 { margin: auto 0 0; font-family: var(--font-display); font-size: 1.8rem; letter-spacing: -0.04em; line-height: 1; }
  .resource-card p { max-width: 36rem; margin: 0; color: var(--color-muted); }
  .resource-card > strong { color: var(--color-primary-dark); font-size: 0.78rem; }

  @media (max-width: 62rem) {
    .story-index { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .story-index li { border-bottom: 1px solid var(--color-line); }
    .story-index li:nth-child(2n) { border-right: 0; }
    .story-index li:last-child { grid-column: 1 / -1; border-bottom: 0; }
    .story-index a { min-height: 7rem; }
    .substeps li { grid-template-columns: 1fr; }
  }
  @media (max-width: 50rem) {
    .hero-grid, .section-heading, .step-layout { grid-template-columns: 1fr; }
    .section-heading > p { margin-top: var(--space-4); }
    .step-copy, .step-layout.with-visual .step-copy, .substeps { margin-left: 0; }
    .wave-lab { min-height: 19rem; }
    .resource-list { grid-template-columns: 1fr; }
  }
  @media (max-width: 38rem) {
    .section-tabs { display: grid; }
    .story-index { grid-template-columns: 1fr; }
    .story-index li, .story-index li:nth-child(2n) { border-right: 0; }
    .story-index li:last-child { grid-column: auto; }
    .story-index a { min-height: auto; gap: var(--space-3); }
    .step-heading { gap: var(--space-3); }
    .step-number { width: 2.6rem; }
    .game-shell iframe { height: 74vh; min-height: 34rem; }
  }
</style>
