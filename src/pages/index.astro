---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout lang="en">
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow">Physics · Education · Outreach</p>
      <h1>Physics, made tangible.</h1>
      <p>I design experiments and interactive activities that help teenagers predict, measure and understand complex phenomena.</p>
      <a class="primary-action" href={`${base}/scienteens-lab/`}>
        View the Scienteens Lab portfolio <span aria-hidden="true">→</span>
      </a>
    </div>

    <a class="featured-card" href={`${base}/scienteens-lab/`} aria-label="Open the Scienteens Lab portfolio">
      <span class="card-label">Featured portfolio</span>
      <strong>Scienteens Lab</strong>
      <span>Physics & Sustainability</span>
      <svg viewBox="0 0 360 180" role="img" aria-label="Abstract standing wave">
        <path class="tube" d="M12 32 V148 M348 32 V148" />
        <path class="wave wave-a" d="M12 90 C68 20 124 20 180 90 S292 160 348 90" />
        <path class="wave wave-b" d="M12 90 C68 160 124 160 180 90 S292 20 348 90" />
        <circle cx="180" cy="90" r="7" />
      </svg>
      <span class="card-link">Open portfolio <span aria-hidden="true">↗</span></span>
    </a>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    min-height: calc(100vh - 4.8rem);
    grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 7rem);
    padding-block: clamp(4rem, 9vw, 8rem);
  }
  h1 {
    max-width: 9ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4rem, 9vw, 8rem);
    font-weight: 760;
    letter-spacing: -0.07em;
    line-height: 0.88;
  }
  .hero-copy > p:not(.eyebrow) {
    max-width: 36rem;
    margin: var(--space-5) 0;
    color: var(--color-muted);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
  }
  .primary-action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.9rem 1.2rem;
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    color: white;
    font-weight: 750;
    text-decoration: none;
  }
  .primary-action:hover { background: var(--color-primary-dark); }
  .featured-card {
    display: grid;
    min-height: 31rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-ink);
    color: var(--color-surface);
    box-shadow: var(--shadow-soft);
    text-decoration: none;
  }
  .card-label {
    color: #b7c5be;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .featured-card strong {
    align-self: end;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4.5rem);
    letter-spacing: -0.055em;
    line-height: 0.95;
  }
  .featured-card > span:nth-of-type(2) { color: #b7c5be; }
  svg { width: 100%; margin-block: var(--space-4); overflow: visible; }
  .tube { fill: none; stroke: #b7c5be; stroke-width: 3; }
  .wave { fill: none; stroke-width: 3; }
  .wave-a { stroke: var(--color-accent); }
  .wave-b { stroke: #65c2aa; }
  circle { fill: var(--color-surface); }
  .card-link { align-self: end; color: #dce6e1; font-weight: 750; }
  @media (max-width: 48rem) {
    .hero { min-height: auto; grid-template-columns: 1fr; }
    .featured-card { min-height: 26rem; }
  }
</style>
