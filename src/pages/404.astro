---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Page introuvable">
  <section class="page-intro container not-found"><p class="eyebrow">Erreur 404</p><h1>Cette page reste à découvrir.</h1><p>Le lien suivi n’existe pas ou a été déplacé.</p><a href={`${base}/`}>Revenir à l’accueil</a></section>
</BaseLayout>
<style>
  .not-found { min-height: 65vh; }
  .not-found a { display: inline-block; margin-top: var(--space-4); color: var(--color-primary); font-weight: 750; }
</style>
