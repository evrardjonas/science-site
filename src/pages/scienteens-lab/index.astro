---
import BaseLayout from '../../layouts/BaseLayout.astro';
import content from '../../content/scienteens.json';

const { meta, hero, interview, other } = content;
---

<BaseLayout title={meta.title} description={meta.description} lang="en">
  <section class="portfolio-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1>{hero.title}</h1>
        <p class="lead">{hero.introduction}</p>
        <nav class="section-tabs" aria-label="Scienteens Lab sections">
          <a class="primary-tab" href={'#' + interview.id}>{interview.tab}</a>
          <a href={'#' + other.id}>{other.tab}</a>
        </nav>
      </div>

      <aside class="brief" aria-label="Interview workshop summary">
        <span class="brief-number">Interview workshop</span>
        {interview.facts.map((fact) => (
          <div>
            <span>{fact.label}</span>
            <strong>{fact.value}</strong>
          </div>
        ))}
      </aside>
    </div>
  </section>

  <section id={interview.id} class="section container">
    <header class="section-heading">
      <div>
        <p class="eyebrow">{interview.eyebrow}</p>
        <h2>{interview.title}</h2>
      </div>
      <p>{interview.summary}</p>
    </header>

    <article class="featured-project">
      <div class="project-copy">
        <p>{interview.description}</p>
        <div class="project-tags" aria-label="Workshop topics">
          {interview.tags.map((tag) => <span>{tag}</span>)}
        </div>
        <h3>Learning objectives</h3>
        <ul>
          {interview.objectives.map((objective) => <li>{objective}</li>)}
        </ul>
      </div>

      <div class="wave-lab" aria-label="Illustration of a standing wave in a tube">
        <div class="wave-label"><span>air-column response</span><span>resonant mode</span></div>
        <svg viewBox="0 0 720 330" role="img" aria-label="Standing-wave pattern between two ends of a tube">
          <rect x="32" y="56" width="656" height="218" rx="18"></rect>
          <line x1="32" y1="165" x2="688" y2="165"></line>
          <path class="wave wave-one" d="M32 165 C87 68 142 68 197 165 S307 262 362 165 S472 68 527 165 S637 262 688 165"></path>
          <path class="wave wave-two" d="M32 165 C87 262 142 262 197 165 S307 68 362 165 S472 262 527 165 S637 68 688 165"></path>
          <g class="nodes">
            <circle cx="32" cy="165" r="8"></circle><circle cx="197" cy="165" r="8"></circle>
            <circle cx="362" cy="165" r="8"></circle><circle cx="527" cy="165" r="8"></circle><circle cx="688" cy="165" r="8"></circle>
          </g>
        </svg>
        <div class="scale"><span>predict</span><span>observe</span><span>measure</span></div>
      </div>
    </article>
  </section>

  <section class="method-section" aria-labelledby="workshop-sequence-title">
    <div class="container">
      <header class="section-heading light">
        <div>
          <p class="eyebrow">Workshop sequence</p>
          <h2 id="workshop-sequence-title">From prediction to a value for the speed of sound.</h2>
        </div>
        <p>Each step produces an observation or measurement that can be compared with the initial wave model.</p>
      </header>

      <ol class="method-steps">
        {interview.sequence.map((step) => (
          <li><span>{step.number}</span><strong>{step.title}</strong><p>{step.text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section id={other.id} class="section container other-section" aria-labelledby="other-title">
    <header class="section-heading compact-heading">
      <div>
        <p class="eyebrow">{other.eyebrow}</p>
        <h2 id="other-title">{other.title}</h2>
      </div>
      <p>{other.description}</p>
    </header>
  </section>
</BaseLayout>

<style>
  .portfolio-hero { padding-block: clamp(4.5rem, 10vw, 9rem); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 0.55fr); gap: clamp(3rem, 8vw, 8rem); align-items: end; }
  h1 { max-width: 11ch; margin: 0; font-family: var(--font-display); font-size: clamp(3.7rem, 8vw, 7.6rem); font-weight: 760; letter-spacing: -0.07em; line-height: 0.9; }
  .lead { max-width: var(--text-width); margin: var(--space-5) 0 0; color: var(--color-muted); font-size: clamp(1.12rem, 2.2vw, 1.45rem); }
  .section-tabs { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-5); }
  .section-tabs a { padding: 0.62rem 0.85rem; border: 1px solid var(--color-line); border-radius: var(--radius-sm); background: var(--color-surface); color: var(--color-primary-dark); font-size: 0.9rem; font-weight: 750; text-decoration: none; }
  .section-tabs a:hover { border-color: var(--color-primary); }
  .section-tabs .primary-tab { border-color: var(--color-ink); background: var(--color-ink); color: var(--color-surface); }
  .brief { display: grid; gap: var(--space-4); padding: var(--space-5); border-radius: var(--radius-lg); background: var(--color-ink); color: var(--color-surface); }
  .brief-number { color: var(--color-accent); font-size: 0.78rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }
  .brief div { display: grid; gap: var(--space-1); padding-top: var(--space-3); border-top: 1px solid var(--color-muted); }
  .brief div span { color: var(--color-line); font-size: 0.75rem; font-weight: 750; letter-spacing: 0.1em; text-transform: uppercase; }
  .brief strong { font-family: var(--font-display); font-size: 1.25rem; line-height: 1.25; }
  .section { padding-block: var(--space-7); scroll-margin-top: var(--space-7); }
  .section-heading { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(17rem, 0.55fr); column-gap: clamp(2rem, 7vw, 7rem); align-items: end; margin-bottom: var(--space-6); }
  .section-heading h2 { max-width: 16ch; margin: 0; font-family: var(--font-display); font-size: clamp(2.5rem, 5vw, 4.7rem); letter-spacing: -0.06em; line-height: 0.98; }
  .section-heading > p { margin: 0; color: var(--color-muted); }
  .featured-project { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(23rem, 1.15fr); gap: clamp(2rem, 6vw, 6rem); padding: clamp(1.5rem, 4vw, 3.5rem); border: 1px solid var(--color-line); border-radius: var(--radius-lg); background: var(--color-surface); box-shadow: var(--shadow-soft); }
  .project-copy h3 { margin: var(--space-5) 0 0; font-family: var(--font-display); font-size: 1.5rem; letter-spacing: -0.045em; line-height: 1; }
  .project-copy > p { margin-top: 0; color: var(--color-muted); font-size: 1.08rem; }
  .project-copy ul { padding-left: var(--space-4); margin: var(--space-4) 0 0; }
  .project-copy li + li { margin-top: var(--space-2); }
  .project-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-block: var(--space-4); }
  .project-tags span { display: inline-block; padding: 0.35rem 0.55rem; border-radius: var(--radius-sm); background: var(--color-surface-strong); color: var(--color-primary-dark); font-size: 0.75rem; font-weight: 750; }
  .wave-lab { display: grid; align-content: space-between; min-height: 29rem; padding: var(--space-4); border-radius: var(--radius-md); background: var(--color-ink); color: var(--color-surface); }
  .wave-label, .scale { display: flex; justify-content: space-between; gap: var(--space-3); color: var(--color-line); font-size: 0.7rem; font-weight: 750; letter-spacing: 0.09em; text-transform: uppercase; }
  .wave-lab svg { width: 100%; }
  .wave-lab rect { fill: none; stroke: var(--color-muted); stroke-width: 2; }
  .wave-lab line { stroke: var(--color-muted); stroke-dasharray: 5 7; }
  .wave { fill: none; stroke-width: 4; }
  .wave-one { stroke: var(--color-accent); }
  .wave-two { stroke: var(--color-surface-strong); }
  .nodes circle { fill: var(--color-surface); }
  .method-section { padding-block: var(--space-7); background: var(--color-ink); color: var(--color-surface); }
  .section-heading.light h2 { color: var(--color-surface); }
  .section-heading.light > p { color: var(--color-line); }
  .method-steps { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); padding: 0; margin: 0; list-style: none; border-block: 1px solid var(--color-muted); }
  .method-steps li { min-height: 18rem; padding: var(--space-4); border-right: 1px solid var(--color-muted); }
  .method-steps li:last-child { border-right: 0; }
  .method-steps span { color: var(--color-accent); font-size: 0.75rem; font-weight: 850; }
  .method-steps strong { display: block; margin-top: var(--space-7); font-family: var(--font-display); font-size: 1.25rem; line-height: 1.1; }
  .method-steps p { color: var(--color-line); font-size: 0.9rem; }
  .other-section { border-top: 1px solid var(--color-line); }
  .compact-heading { margin-bottom: 0; }

  @media (max-width: 62rem) {
    .method-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .method-steps li { border-bottom: 1px solid var(--color-muted); }
    .method-steps li:nth-child(2n) { border-right: 0; }
    .method-steps li:last-child { grid-column: 1 / -1; min-height: 13rem; }
    .method-steps strong { margin-top: var(--space-5); }
  }
  @media (max-width: 50rem) {
    .hero-grid, .section-heading, .featured-project { grid-template-columns: 1fr; }
    .section-heading > p { margin-top: var(--space-4); }
  }
  @media (max-width: 38rem) {
    .section-tabs { display: grid; }
    .method-steps { grid-template-columns: 1fr; }
    .method-steps li, .method-steps li:nth-child(2n) { min-height: auto; border-right: 0; }
    .method-steps li:last-child { grid-column: auto; }
    .wave-lab { min-height: 20rem; }
  }
</style>
