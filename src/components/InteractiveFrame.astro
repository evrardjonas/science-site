---
interface Props { src: string; title: string; height?: string; allowFullscreen?: boolean; lang?: 'fr' | 'en'; }
const { src, title, height = '42rem', allowFullscreen = true, lang = 'fr' } = Astro.props;
const openLabel = lang === 'en' ? 'Open in a new tab' : 'Ouvrir dans un nouvel onglet';
---

<section class="interactive-frame" style={`--frame-height: ${height}`}>
  <div class="frame-toolbar">
    <strong>{title}</strong>
    <a href={src} target="_blank" rel="noreferrer">{openLabel} <span aria-hidden="true">↗</span></a>
  </div>
  <iframe src={src} title={title} loading="lazy" allowfullscreen={allowFullscreen} sandbox="allow-scripts allow-same-origin allow-forms allow-pointer-lock allow-popups"></iframe>
</section>

<style>
  .interactive-frame { overflow: hidden; border: 1px solid var(--color-line); border-radius: var(--radius-lg); background: var(--color-surface); box-shadow: var(--shadow-soft); }
  .frame-toolbar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--color-line); }
  .frame-toolbar a { color: var(--color-primary); font-size: 0.9rem; font-weight: 700; text-decoration: none; }
  iframe { width: 100%; height: min(var(--frame-height), 78vh); border: 0; background: white; }
</style>
